# CareDOM Environment Configuration Example

# 🧠 Person 1: AI Engine Keys
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=path_to_gcp_sa.json

# ⚙️ Person 2: Database & Backend Keys
DATABASE_URL=postgresql+asyncpg://caredom_user:caredom_pass@localhost:5432/caredom_db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=super_secret_jwt_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 🖥️ Person 3: Frontend Keys
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SSE_ALERT_URL=http://localhost:8000/api/v1/alerts/stream

# 🎙️ Person 4: Voice & Alert Gateway Keys
WHATSAPP_CLOUD_API_TOKEN=your_meta_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_DLT_TE_ID=your_trai_dlt_template_id
